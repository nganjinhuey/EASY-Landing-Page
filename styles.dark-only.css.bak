/* =====================================================================
   WeCare by WeKongsi — dark edition
   Design language referenced from INFII (near-black canvas, glass pill
   navigation, oversized display type, gradient pill CTAs, floating glass
   cards). Driven by WeKongsi navy + teal/turquoise, not INFII's violet.
   Mobile-first. Breakpoints: base 320+, tablet 768+, desktop 1024+
   ===================================================================== */

/* ---------- 1. TOKENS ---------- */
:root{
  /* Canvas — WeKongsi navy pushed toward black */
  --bg:#050B1F;
  --bg-alt:#08122A;
  --bg-deep:#03081A;

  /* Glass surfaces */
  --glass:rgba(255,255,255,.055);
  --glass-2:rgba(255,255,255,.085);
  --glass-3:rgba(255,255,255,.12);
  --line:rgba(255,255,255,.10);
  --line-2:rgba(255,255,255,.18);

  /* Brand accent */
  --turq:#00D6C4;
  --teal:#00BFAE;
  --deep:#008F89;
  --navy:#07133F;
  --on-accent:#03121B;          /* text that sits on the bright accent */

  /* Ink */
  --text:#FFFFFF;
  --text-2:rgba(255,255,255,.72);
  --text-3:rgba(255,255,255,.52);

  /* Restrained urgency accent */
  --warn:#FFB27A;
  --warn-bg:rgba(255,150,80,.12);
  --warn-line:rgba(255,150,80,.28);

  --grad-accent:linear-gradient(120deg,var(--turq) 0%,var(--teal) 55%,var(--deep) 100%);
  --grad-pill:linear-gradient(120deg,#0AE6D2 0%,#00C9B8 100%);

  --glow:0 14px 44px -14px rgba(0,214,196,.55);
  --glow-sm:0 8px 26px -10px rgba(0,214,196,.45);
  --sh-card:0 1px 0 rgba(255,255,255,.05) inset,0 24px 50px -30px rgba(0,0,0,.9);
  --sh-float:0 30px 60px -32px rgba(0,0,0,.95),0 2px 0 rgba(255,255,255,.06) inset;

  --r-card:24px;
  --r-lg:28px;
  --r-pill:999px;

  --pad-x:20px;
  --sec-y:72px;
  --focus:var(--turq);
}

/* ---------- 2. RESET ---------- */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body,h1,h2,h3,h4,p,ul,ol,li,figure,figcaption,blockquote{margin:0;padding:0}
ul,ol{list-style:none}
img,svg{display:block;max-width:100%}
img{height:auto}
button{font:inherit;color:inherit;background:none;border:0}
a{color:inherit;text-decoration:none}
s{text-decoration-thickness:1.5px}

body{
  font-family:"Outfit",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  font-size:15.5px;line-height:1.6;font-weight:400;
  color:var(--text-2);
  background:var(--bg);
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}

/* Ambient light, the way the reference lifts a near-black page */
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(760px 520px at 78% -6%,rgba(0,191,174,.20),transparent 62%),
    radial-gradient(620px 460px at 6% 12%,rgba(0,143,137,.14),transparent 60%);
}
body>*{position:relative;z-index:1}

/* ---------- 3. LAYOUT ---------- */
.container{width:100%;max-width:1240px;margin-inline:auto;padding-inline:var(--pad-x)}
.container--narrow{max-width:820px}
.section{padding-block:var(--sec-y);position:relative}
section[id]{scroll-margin-top:92px}
.sprite{position:absolute;width:0;height:0;overflow:hidden}

.skip-link{
  position:absolute;left:12px;top:-64px;z-index:200;
  background:var(--turq);color:var(--on-accent);padding:12px 20px;
  border-radius:0 0 14px 14px;font-weight:700;transition:top .18s ease;
}
.skip-link:focus{top:0}

/* ---------- 4. TYPOGRAPHY ---------- */
h1,h2,h3{
  font-family:"Red Hat Display","Outfit",system-ui,sans-serif;
  color:var(--text);font-weight:800;letter-spacing:-.03em;line-height:1.04;
}
h2,h3{text-wrap:balance}
h1{font-size:clamp(38px,11.4vw,62px);letter-spacing:-.04em}
h2{font-size:clamp(29px,8vw,40px)}
h3{font-size:18px;font-weight:700;letter-spacing:-.02em;line-height:1.25}

.eyebrow{
  display:inline-flex;align-items:center;
  font-size:11.5px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;
  color:var(--turq);margin-bottom:14px;
}
.eyebrow--muted{color:var(--text-3)}

.section-head{max-width:660px;margin:0 auto 34px;text-align:center}
.section-head--left{text-align:left;margin-inline:0}
.section-lede{margin-top:14px;font-size:16px;color:var(--text-2)}

/* ---------- 5. ICONS ---------- */
.ico{
  width:24px;height:24px;flex:none;
  fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;
}
.ico-sm{width:16px;height:16px;stroke-width:1.9}
.ico-lg{width:30px;height:30px;stroke-width:1.5}

/* ---------- 6. BUTTONS — pill-first, like the reference ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  min-height:52px;padding:15px 28px;border-radius:var(--r-pill);
  font-family:"Outfit",sans-serif;font-size:15.5px;font-weight:600;letter-spacing:.01em;
  text-align:center;cursor:pointer;
  transition:transform .2s ease,box-shadow .25s ease,filter .2s ease,background-color .2s ease,border-color .2s ease;
  -webkit-tap-highlight-color:transparent;
}
.btn-primary{
  background-image:var(--grad-pill);color:var(--on-accent);font-weight:700;
  box-shadow:var(--glow);
}
.btn-primary:hover{filter:brightness(1.08);box-shadow:0 18px 54px -14px rgba(0,214,196,.75);transform:translateY(-1px)}
.btn-primary:active{transform:translateY(1px);filter:brightness(.96)}

.btn-white{background:#fff;color:var(--navy);font-weight:700;box-shadow:0 14px 40px -16px rgba(0,0,0,.9)}
.btn-white:hover{background:#EAFBF9;transform:translateY(-1px)}
.btn-white:active{transform:translateY(1px)}

.btn-outline{
  background:var(--glass);color:var(--text);font-weight:600;
  border:1px solid var(--line-2);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
}
.btn-outline:hover{background:var(--glass-2);border-color:var(--turq);color:var(--turq)}
.btn-outline:active{transform:translateY(1px)}

.btn-ghost{
  background:var(--glass);color:var(--turq);font-size:14.5px;font-weight:600;
  border:1px solid var(--line-2);
}
.btn-ghost:hover{background:var(--glass-2);border-color:var(--turq)}

.btn-lg{width:100%;min-height:58px;font-size:16.5px;padding:17px 30px}
.btn-sm{min-height:42px;padding:10px 20px;font-size:14px}

:focus-visible{outline:3px solid var(--focus);outline-offset:3px;border-radius:8px}
.btn:focus-visible{outline:3px solid var(--focus);outline-offset:4px}

/* ---------- 7. HEADER — floating glass pill ---------- */
.site-header{
  position:fixed;top:0;left:0;right:0;z-index:100;
  padding-top:env(safe-area-inset-top);
  background:transparent;border-bottom:1px solid transparent;
  transition:background .3s ease,border-color .3s ease,backdrop-filter .3s ease;
}
.site-header.is-stuck{
  background:rgba(5,11,31,.82);
  border-bottom-color:var(--line);
  -webkit-backdrop-filter:saturate(180%) blur(18px);backdrop-filter:saturate(180%) blur(18px);
}
.header-inner{display:flex;align-items:center;gap:12px;min-height:68px}

.brand{display:flex;align-items:center;gap:11px;margin-right:auto;min-width:0}
.brand-logo{height:30px;width:auto;filter:brightness(0) invert(1);opacity:.96}
.brand-divider{width:1px;height:22px;background:var(--line-2);flex:none}
.brand-product{
  font-family:"Red Hat Display",sans-serif;
  font-size:14px;font-weight:800;letter-spacing:-.01em;color:var(--turq);
  background:rgba(0,214,196,.12);border:1px solid rgba(0,214,196,.3);
  padding:5px 13px;border-radius:var(--r-pill);
}
.site-nav{display:none}
.header-cta{flex:none}

@media (max-width:359px){
  .brand-divider,.brand-product{display:none}
  .brand-logo{height:27px}
}
@media (min-width:768px){
  :root{--pad-x:32px;--sec-y:96px}
  .header-inner{min-height:80px}
  .brand-logo{height:34px}
}
@media (min-width:1024px){
  :root{--pad-x:40px;--sec-y:124px}
  body{font-size:16.5px}
  h1{font-size:clamp(56px,4.8vw,80px)}
  h2{font-size:clamp(38px,3.1vw,52px)}
  h3{font-size:20px}
  .section-head{margin-bottom:56px}
  .section-lede{font-size:18px}

  .site-nav{
    display:flex;align-items:center;gap:6px;
    position:absolute;left:50%;transform:translateX(-50%);
    background:var(--glass);border:1px solid var(--line);
    -webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);
    padding:6px;border-radius:var(--r-pill);
  }
  .site-nav a{
    font-size:14.5px;font-weight:500;color:var(--text-2);
    padding:10px 18px;border-radius:var(--r-pill);
    transition:color .2s ease,background-color .2s ease;
  }
  .site-nav a:hover{color:var(--text);background:var(--glass-2)}
  .header-inner{position:relative}
}

/* =====================================================================
   02. HERO — full-bleed image, oversized display type
   ===================================================================== */
.hero{position:relative;padding-block:96px 44px;overflow:hidden}
.hero-deco{position:absolute;inset:0;pointer-events:none;opacity:.35}
.hero-deco svg{width:100%;height:100%}
.hero-copy{position:relative;z-index:2}

.badge-free{
  display:inline-flex;align-items:center;gap:9px;
  background:rgba(0,214,196,.12);border:1px solid rgba(0,214,196,.32);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  color:var(--turq);
  font-size:12px;font-weight:700;letter-spacing:.16em;
  padding:9px 18px;border-radius:var(--r-pill);margin-bottom:22px;
}
.badge-dot{width:7px;height:7px;border-radius:50%;background:var(--turq);flex:none;
  box-shadow:0 0 12px 2px rgba(0,214,196,.9);animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.78)}}

.hero h1{margin-bottom:18px}
.hero-sub{font-size:17px;line-height:1.5;max-width:30ch;color:var(--text-2)}
.hero-price{margin-top:18px;font-size:17px;color:var(--text)}
.hero-price strong{
  font-family:"Red Hat Display",sans-serif;
  font-size:30px;font-weight:800;letter-spacing:-.03em;
  background-image:var(--grad-accent);-webkit-background-clip:text;background-clip:text;color:transparent;
  margin-right:4px;
}
.cur{font-size:.52em;font-weight:700;vertical-align:.46em;letter-spacing:-.01em;margin-right:1px}
.hero-cta{margin-top:26px}

.hero-reassure,.hero-hours{
  display:flex;align-items:flex-start;gap:9px;
  font-size:14px;line-height:1.45;color:var(--text-3);
}
.hero-reassure{margin-top:16px;font-weight:600;color:var(--text-2)}
.hero-hours{margin-top:9px}
.hero-reassure .ico,.hero-hours .ico{color:var(--turq);margin-top:2px}

.hero-figure{
  position:relative;z-index:1;margin-top:30px;
  border-radius:var(--r-lg);overflow:hidden;
  box-shadow:var(--sh-float);border:1px solid var(--line);
  background:#0A1730;
}
.hero-figure img{width:100%;aspect-ratio:4/3;object-fit:cover;object-position:72% 50%}
.hero-figure::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(190deg,rgba(5,11,31,0) 40%,rgba(5,11,31,.55) 100%);
}

.hero-chip{
  position:absolute;left:14px;bottom:14px;z-index:2;
  display:flex;align-items:center;gap:10px;
  background:rgba(8,18,42,.72);border:1px solid var(--line-2);
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  border-radius:var(--r-pill);padding:10px 16px 10px 13px;
}
.hero-chip .ico{color:var(--turq)}
.hero-chip span{display:block;font-size:11.5px;line-height:1.35;color:var(--text-3)}
.hero-chip b{display:block;font-size:12.5px;font-weight:700;color:var(--text)}

@media (min-width:600px){.hero-figure img{aspect-ratio:16/10;object-position:70% 50%}}
@media (min-width:768px){
  .hero{padding-block:124px 80px}
  .hero-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.92fr);gap:36px;align-items:center}
  .hero-figure{margin-top:0}
  .hero-figure img{aspect-ratio:4/5;object-position:78% 50%}
  .hero-cta{width:auto;min-width:300px}
}
@media (min-width:1024px){
  .hero{padding:0;min-height:760px;display:flex;align-items:center}
  .hero-inner{padding-block:150px 110px}
  .hero-deco{display:none}
  .hero-inner{display:block;padding-block:110px;position:static}
  .hero-copy{max-width:620px}
  .hero-figure{position:absolute;inset:0;margin:0;border-radius:0;border:0;box-shadow:none;z-index:0}
  .hero-figure img{width:100%;height:100%;aspect-ratio:auto;object-position:64% 42%}
  .hero-figure::after{
    background:
      linear-gradient(95deg,rgba(5,11,31,.97) 0%,rgba(5,11,31,.92) 34%,rgba(5,11,31,.6) 52%,rgba(5,11,31,.15) 68%,rgba(5,11,31,0) 80%),
      linear-gradient(180deg,rgba(5,11,31,.7) 0%,rgba(5,11,31,0) 30%);
  }
  .hero-chip{left:auto;right:6%;bottom:10%;padding:13px 22px 13px 17px}
  .hero-chip span{font-size:12.5px}
  .hero-chip b{font-size:14px}
  .hero-sub{font-size:20px;max-width:27ch}
  .hero-price{font-size:18px;margin-top:22px}
  .hero-price strong{font-size:38px}
  .hero-cta{margin-top:32px}
}
@media (min-width:1440px){.hero{min-height:820px}.hero-copy{max-width:680px}}

/* =====================================================================
   03. QUICK BENEFITS — floating glass cards
   ===================================================================== */
.benefits{background:transparent}
.benefit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.benefit-card{
  background:var(--glass);border:1px solid var(--line);border-radius:var(--r-card);
  padding:14px 14px 20px;box-shadow:var(--sh-card);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
  transition:transform .25s ease,border-color .25s ease,background-color .25s ease;
}
.benefit-card:hover{transform:translateY(-4px);border-color:var(--line-2);background:var(--glass-2)}
.benefit-card h3{font-size:15.5px;margin-bottom:7px}
.benefit-card p{font-size:13.5px;line-height:1.5;color:var(--text-3)}

.bcard-visual{
  position:relative;aspect-ratio:3/2;margin-bottom:15px;
  border-radius:18px;overflow:hidden;
  background:linear-gradient(150deg,rgba(0,214,196,.16),rgba(0,143,137,.08));
}
[data-slot]{position:relative}
[data-slot]>img[data-optional]{
  position:absolute;inset:0;z-index:1;width:100%;height:100%;object-fit:cover;
  opacity:0;transition:opacity .4s ease;
}
[data-slot].is-ready>img[data-optional]{opacity:1}
html:not(.js) [data-slot]>img[data-optional]{opacity:1}
.bcard-visual.is-ready{background:#fff}
.bcard-visual.is-ready::after{display:none}
.visual-fallback{position:absolute;inset:0;z-index:0;display:grid;place-items:center}
.visual-fallback .ico{stroke:var(--turq);stroke-width:1.35;position:relative;z-index:1}
.bcard-visual .visual-fallback .ico{width:28%;height:auto;max-width:74px;aspect-ratio:1;stroke-width:1.25}
.vf-glow{
  position:absolute;width:78%;aspect-ratio:1;border-radius:50%;
  background:radial-gradient(circle,rgba(0,214,196,.4) 0%,rgba(0,214,196,0) 70%);
}

@media (min-width:600px){
  .benefit-grid{gap:14px}
  .benefit-card{padding:15px 16px 20px}
}
@media (min-width:768px){.benefit-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .benefit-card h3{min-height:2.6em}}
@media (min-width:1024px){
  .benefit-grid{gap:20px}
  .benefit-card{padding:20px 22px 28px;border-radius:var(--r-lg)}
  .benefit-card h3{font-size:18px}
  .benefit-card p{font-size:14.5px}
}

/* =====================================================================
   03b. WHY CHOOSE TELECONSULTATION
   ===================================================================== */
.why-tele{background:transparent}
.why-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.why-card{
  background:var(--glass);border:1px solid var(--line);border-radius:var(--r-card);
  padding:20px 16px;box-shadow:var(--sh-card);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
  transition:transform .25s ease,border-color .25s ease,background-color .25s ease;
}
.why-card:hover{transform:translateY(-4px);border-color:var(--line-2);background:var(--glass-2)}
.why-icon{
  width:50px;height:50px;border-radius:var(--r-pill);margin-bottom:14px;
  display:grid;place-items:center;
  background:rgba(0,214,196,.12);border:1px solid rgba(0,214,196,.28);
}
.why-icon .ico{stroke:var(--turq);stroke-width:1.5;width:26px;height:26px}
.why-card h3{font-size:15.5px;margin-bottom:7px}
.why-card p{font-size:13.5px;line-height:1.5;color:var(--text-3)}

.why-note{
  display:flex;align-items:flex-start;gap:10px;margin-top:22px;
  background:var(--glass);border:1px solid var(--line);border-radius:var(--r-pill);
  padding:14px 20px;font-size:13.5px;font-weight:600;color:var(--text-2);
}
.why-note .ico{color:var(--turq);margin-top:2px}

@media (min-width:600px){
  .why-grid{gap:16px}
  .why-card{padding:24px 22px}
  .why-card h3{font-size:17px}
  .why-card p{font-size:14px}
}
@media (min-width:1024px){
  .why-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
  .why-card{padding:32px 26px;border-radius:var(--r-lg)}
  .why-card h3{font-size:19px;min-height:2.5em}
  .why-card p{font-size:14.5px}
  .why-icon{width:60px;height:60px;margin-bottom:18px}
  .why-icon .ico{width:30px;height:30px}
  .why-note{justify-content:center;align-items:center;font-size:15.5px;margin-top:34px}
}

/* =====================================================================
   04. WHAT YOU GET — chain + phone mockup
   ===================================================================== */
.what-you-get{background:var(--bg-alt);overflow:hidden}
.wyg-grid{display:grid;gap:34px}
.wyg-grid>.section-head{order:1;margin-bottom:0}
.wyg-visual{order:2}
.chain{order:3}

.chain-step{position:relative;display:flex;gap:15px;padding-bottom:22px}
.chain-step:last-child{padding-bottom:0}
.chain-step::before{
  content:"";position:absolute;left:21px;top:46px;bottom:2px;width:1.5px;border-radius:2px;
  background:linear-gradient(180deg,rgba(0,214,196,.5),rgba(0,214,196,.04));
}
.chain-step:last-child::before{display:none}
.chain-icon{
  width:44px;height:44px;border-radius:var(--r-pill);flex:none;display:grid;place-items:center;
  background:rgba(0,214,196,.1);border:1px solid rgba(0,214,196,.26);color:var(--turq);
}
.chain-icon .ico{width:21px;height:21px}
.chain-step h3{font-size:16px;margin-bottom:4px}
.chain-step p{font-size:13.5px;line-height:1.5;color:var(--text-3)}
.chain-step strong{color:var(--text);font-weight:600}

.wyg-visual{position:relative;display:grid;place-items:center;padding-block:52px 48px}
.wyg-glow{
  position:absolute;width:min(380px,92%);aspect-ratio:1;border-radius:50%;
  background:radial-gradient(circle,rgba(0,214,196,.26) 0%,rgba(0,214,196,0) 70%);
}

/* Phone */
.phone{
  position:relative;width:236px;padding:7px;border-radius:40px;
  background:linear-gradient(160deg,rgba(255,255,255,.2) 0%,rgba(255,255,255,.06) 60%);
  box-shadow:var(--sh-float);
}
.phone-notch{position:absolute;top:15px;left:50%;transform:translateX(-50%);z-index:3;
  width:62px;height:5px;border-radius:3px;background:rgba(255,255,255,.2)}
.phone-screen{
  border-radius:34px;overflow:hidden;aspect-ratio:9/17;
  background:linear-gradient(180deg,#0A1730 0%,#050B1F 100%);
  display:flex;flex-direction:column;
}
.ps-status{display:flex;justify-content:space-between;align-items:center;padding:10px 16px 0;font-size:10px;font-weight:600;color:var(--text-3)}
.ps-bars{display:flex;align-items:flex-end;gap:2px}
.ps-bars i{width:2.5px;background:var(--text-3);border-radius:1px}
.ps-bars i:nth-child(1){height:4px}.ps-bars i:nth-child(2){height:6px}
.ps-bars i:nth-child(3){height:8px}.ps-bars i:nth-child(4){height:10px}

.ps-app{flex:1;display:flex;flex-direction:column;gap:7px;padding:13px 11px 14px}
.ps-appbar{display:flex;align-items:center;justify-content:space-between}
.ps-app-name{font-family:"Red Hat Display",sans-serif;font-size:13.5px;font-weight:800;color:var(--text)}
.ps-pill{font-size:8.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:var(--on-accent);background-image:var(--grad-pill);padding:4px 9px;border-radius:var(--r-pill)}

.ps-doctor{display:flex;align-items:center;gap:9px;background:rgba(0,214,196,.1);
  border:1px solid rgba(0,214,196,.22);border-radius:16px;padding:9px 10px}
.ps-avatar{position:relative;width:30px;height:30px;border-radius:var(--r-pill);flex:none;
  display:grid;place-items:center;background-image:var(--grad-pill);color:var(--on-accent)}
.ps-avatar .ico{width:16px;height:16px}
.ps-dot{position:absolute;top:-3px;right:-3px;width:9px;height:9px;border-radius:50%;
  background:#12E6B4;border:2px solid #0A1730;animation:pulse 2.2s ease-in-out infinite}
.ps-doctor-text{min-width:0}
.ps-doctor-text b{display:block;font-size:11.5px;font-weight:600;color:var(--text);line-height:1.25}
.ps-doctor-text i{display:block;font-style:normal;font-size:10px;color:var(--text-3)}
.ps-live{display:none}

.ps-item{display:flex;align-items:center;gap:9px;background:rgba(255,255,255,.05);
  border:1px solid var(--line);border-radius:14px;padding:9px 10px}
.ps-item-ico{width:26px;height:26px;border-radius:var(--r-pill);flex:none;display:grid;place-items:center;
  background:rgba(0,214,196,.12);color:var(--turq)}
.ps-item>span:nth-child(2){min-width:0}
.ps-item b{display:block;font-size:11px;font-weight:600;color:var(--text);line-height:1.25}
.ps-item i{display:block;font-style:normal;font-size:9.5px;color:var(--text-3);line-height:1.3}
.ps-badge{margin-left:auto;width:19px;height:19px;border-radius:50%;flex:none;display:grid;place-items:center;
  font-size:10px;font-weight:700;color:var(--on-accent);background-image:var(--grad-pill)}

.ps-cta{margin-top:auto;text-align:center;background-image:var(--grad-pill);color:var(--on-accent);
  font-size:11.5px;font-weight:700;padding:12px 10px;border-radius:var(--r-pill)}
.ps-id{display:flex;align-items:center;justify-content:center;gap:5px;margin-top:8px;font-size:9px;color:var(--text-3)}
.ps-id .ico{width:12px;height:12px}

.float-card{
  position:absolute;z-index:3;display:flex;align-items:center;gap:10px;max-width:158px;
  background:rgba(8,18,42,.78);border:1px solid var(--line-2);border-radius:var(--r-pill);
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  padding:10px 14px;box-shadow:var(--sh-float);animation:float 6.5s ease-in-out infinite;
}
.float-card .ico{color:var(--turq)}
.float-card span{display:block;font-size:10px;line-height:1.3;color:var(--text-3)}
.float-card b{display:block;font-size:11.5px;font-weight:600;color:var(--text);line-height:1.3}
.float-card--a{top:0;left:0;animation-delay:-1.2s}
.float-card--b{bottom:0;right:0;animation-delay:-3.4s}
.float-card--c{display:none;animation-delay:-5s}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}

@media (min-width:768px){
  .wyg-grid{gap:40px}
  .chain-step h3{font-size:17.5px}
  .chain-step p{font-size:14.5px}
  .phone{width:258px}
  .wyg-visual{padding-block:28px}
  .float-card{max-width:176px}
  .float-card--c{display:flex}
  .float-card--a{top:4%;left:6%;bottom:auto}
  .float-card--b{top:46%;right:6%;bottom:auto}
  .float-card--c{bottom:4%;left:4%;top:auto}
}
@media (min-width:1024px){
  .wyg-grid{grid-template-columns:minmax(0,1fr) minmax(0,.88fr);column-gap:70px;row-gap:36px;
    align-items:start;grid-template-areas:"head visual" "chain visual"}
  .wyg-grid>.section-head{grid-area:head;order:0}
  .chain{grid-area:chain;order:0}
  .wyg-visual{grid-area:visual;order:0;align-self:center;padding-block:0}
  .chain-step{padding-bottom:26px;gap:17px}
  .chain-icon{width:48px;height:48px}
  .chain-step::before{left:23px;top:52px}
  .phone{width:274px}
  .float-card{width:150px;max-width:none;padding:10px 13px;gap:9px}
  .float-card--a{left:auto;right:calc(50% + 120px);top:2%;bottom:auto}
  .float-card--b{right:auto;left:calc(50% + 96px);top:44%;bottom:auto}
  .float-card--c{left:auto;right:calc(50% + 120px);bottom:2%;top:auto}
}
@media (min-width:1280px){
  .float-card{width:176px;padding:12px 16px}
  .float-card--b{left:calc(50% + 112px)}
}

/* =====================================================================
   05. HOW IT WORKS
   ===================================================================== */
.how{background:transparent}
.step{position:relative;display:flex;gap:18px;padding-bottom:34px}
.step:last-child{padding-bottom:0}
.step-line{
  position:absolute;left:23px;top:56px;bottom:4px;width:1.5px;border-radius:2px;
  background:linear-gradient(180deg,var(--turq),rgba(0,214,196,.06));
  transform:scaleY(0);transform-origin:top;transition:transform .85s cubic-bezier(.22,.7,.3,1) .1s;
}
.step.is-visible .step-line{transform:scaleY(1)}
.step:last-child .step-line{display:none}
.step-num{
  width:48px;height:48px;border-radius:var(--r-pill);flex:none;position:relative;z-index:1;
  display:grid;place-items:center;
  background-image:var(--grad-pill);color:var(--on-accent);
  font-family:"Red Hat Display",sans-serif;font-size:15px;font-weight:800;
  box-shadow:var(--glow-sm);
}
.step-body h3{margin-bottom:8px}
.step-body p{font-size:15px;color:var(--text-2)}

.step-badges{display:flex;flex-wrap:wrap;gap:9px;margin-top:14px}
.step-badges li{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--glass);border:1px solid var(--line-2);border-radius:var(--r-pill);
  padding:8px 15px;font-size:12.5px;font-weight:600;color:var(--text-2);line-height:1.3;
}
.step-badges li.badge-plain{background:transparent;border-color:transparent;padding:8px 2px;color:var(--text-3)}
.step-badges .ico{color:var(--turq);flex:none}

.how-footnote{
  display:flex;align-items:flex-start;gap:11px;margin-top:32px;
  background:var(--glass);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:18px 20px;font-size:14px;font-weight:500;color:var(--text-2);
}
.how-footnote .ico{color:var(--turq);margin-top:2px}

@media (min-width:768px){
  .step-body p{font-size:16px}
  .how-footnote{justify-content:center;align-items:center;font-size:15.5px;margin-top:40px;border-radius:var(--r-pill)}
}
@media (min-width:1024px){
  .steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:44px}
  .step{flex-direction:column;gap:20px;padding-bottom:0}
  .step-line{left:66px;right:-44px;top:24px;bottom:auto;width:auto;height:1.5px;
    background:linear-gradient(90deg,var(--turq),rgba(0,214,196,.06));
    transform:scaleX(0);transform-origin:left}
  .step.is-visible .step-line{transform:scaleX(1)}
  .step-num{width:52px;height:52px;font-size:16px}
}

/* =====================================================================
   05b. MYMED
   ===================================================================== */
.mymed{background:var(--bg-alt)}
.mymed-card{display:grid;gap:32px}
.mymed-copy .section-lede{margin-top:12px}
.mymed-points{margin-top:22px}
.tick-list{display:grid;gap:13px}
.tick-list li{display:flex;align-items:flex-start;gap:11px;font-size:14.5px;color:var(--text-2)}
.tick-list .ico{color:var(--turq);margin-top:3px}

.mymed-visual{position:relative;display:grid;place-items:center;padding-block:8px}
.mv-glow{position:absolute;width:min(340px,90%);aspect-ratio:1;border-radius:50%;
  background:radial-gradient(circle,rgba(0,214,196,.26) 0%,rgba(0,214,196,0) 70%)}
.mv-call{
  position:relative;width:min(310px,100%);
  background:var(--glass);border:1px solid var(--line-2);border-radius:var(--r-lg);
  -webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);
  padding:16px;box-shadow:var(--sh-float);
}
.mv-top{display:flex;align-items:center;gap:11px}
.mymed-logo{position:relative;width:40px;height:40px;flex:none;border-radius:12px;overflow:hidden}
.mymed-logo>img{object-fit:contain}
.mymed-ph{
  display:grid;place-items:center;align-content:center;
  border:1.5px dashed var(--line-2);border-radius:12px;background:rgba(255,255,255,.04);
  font-size:8px;font-weight:700;color:var(--text-3);line-height:1.1;
}
.mymed-ph small{font-size:6.5px;font-weight:500;opacity:.8}
.mv-who{min-width:0}
.mv-who b{display:block;font-family:"Red Hat Display",sans-serif;font-size:14px;font-weight:800;color:var(--text);line-height:1.2}
.mv-who i{display:block;font-style:normal;font-size:11px;color:var(--text-3)}
.mv-live{margin-left:auto;display:flex;align-items:center;gap:6px;flex:none;
  font-size:9.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--turq)}
.mv-live i{width:6px;height:6px;border-radius:50%;background:var(--turq);
  box-shadow:0 0 10px 2px rgba(0,214,196,.8);animation:pulse 2.2s ease-in-out infinite}

.mv-stage{position:relative;margin-top:14px;border-radius:20px;aspect-ratio:4/3;
  display:grid;place-items:center;overflow:hidden;
  background:linear-gradient(160deg,rgba(0,214,196,.16) 0%,rgba(5,11,31,.6) 100%);
  border:1px solid var(--line)}
.mv-ring{position:absolute;width:122px;height:122px;border-radius:50%;border:1.5px solid rgba(0,214,196,.3)}
.mv-doc{position:relative;width:74px;height:74px;border-radius:50%;display:grid;place-items:center;
  color:var(--on-accent);background-image:var(--grad-pill);box-shadow:var(--glow)}
.mv-doc .ico{width:34px;height:34px;stroke-width:1.5}
.mv-label{position:absolute;left:50%;bottom:13px;transform:translateX(-50%);
  background:rgba(8,18,42,.8);border:1px solid var(--line-2);border-radius:var(--r-pill);
  padding:6px 14px;font-size:11px;font-weight:600;color:var(--text);white-space:nowrap}
.mv-ctrls{display:flex;justify-content:center;gap:15px;margin-top:16px}
.mv-btn{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;
  background:var(--glass-2);border:1px solid var(--line);color:var(--turq)}
.mv-btn--end{width:48px;height:48px;color:var(--on-accent);border-color:transparent;
  background-image:var(--grad-pill);box-shadow:var(--glow-sm)}
.mv-btn--end .ico{width:20px;height:20px}
.mv-hours{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:14px;
  font-size:12px;font-weight:600;color:var(--text-3)}
.mv-hours .ico{color:var(--turq)}

.medjourney{
  margin-top:30px;background:var(--glass);border:1px solid var(--line);
  border-radius:var(--r-lg);padding:24px 20px;
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
}
.medjourney-title{font-size:16px;margin-bottom:20px}
.medjourney-steps{display:grid;gap:0}
.medjourney-steps li{position:relative;display:flex;gap:14px;padding-bottom:20px}
.medjourney-steps li:last-child{padding-bottom:0}
.medjourney-steps li::before{content:"";position:absolute;left:20px;top:44px;bottom:2px;width:1.5px;border-radius:2px;
  background:linear-gradient(180deg,rgba(0,214,196,.45),rgba(0,214,196,.04))}
.medjourney-steps li:last-child::before{display:none}
.mj-ico{width:40px;height:40px;border-radius:var(--r-pill);flex:none;display:grid;place-items:center;
  background:rgba(0,214,196,.1);border:1px solid rgba(0,214,196,.26);color:var(--turq)}
.mj-ico .ico{width:20px;height:20px}
.medjourney-steps b{display:block;font-size:14.5px;font-weight:600;color:var(--text);line-height:1.3}
.medjourney-steps div span{display:block;font-size:13px;line-height:1.5;color:var(--text-3);margin-top:3px}
.medjourney-note{
  display:inline-flex;align-items:center;gap:9px;margin-top:20px;
  background:rgba(0,214,196,.1);border:1px solid rgba(0,214,196,.3);
  border-radius:var(--r-pill);padding:10px 18px;
  font-size:13px;font-weight:700;color:var(--turq);
}
.medjourney-note .ico{color:var(--turq)}

@media (min-width:768px){
  .tick-list li{font-size:15.5px}
  .medjourney{padding:30px 26px}
  .medjourney-title{font-size:18px;margin-bottom:24px}
  .medjourney-steps{grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}
  .medjourney-steps li{flex-direction:column;gap:13px;padding-bottom:0}
  .medjourney-steps li::before{left:52px;right:-26px;top:20px;bottom:auto;width:auto;height:1.5px;
    background:linear-gradient(90deg,rgba(0,214,196,.45),rgba(0,214,196,.04))}
}
@media (min-width:1024px){
  .mymed-card{grid-template-columns:minmax(0,1fr) minmax(0,.82fr);gap:64px;align-items:center}
  .mv-call{width:330px}
  .medjourney{margin-top:46px;padding:36px 38px}
}

/* =====================================================================
   06. LIFESTYLE
   ===================================================================== */
.lifestyle{background:transparent}
.lifestyle-grid{display:grid;gap:30px}
.lifestyle-figure{position:relative;border-radius:var(--r-lg);overflow:hidden;
  aspect-ratio:4/3;background:#0A1730;box-shadow:var(--sh-float);border:1px solid var(--line)}
.lf-photo{position:absolute;inset:0;background-repeat:no-repeat;
  background-image:url(images/wecare-hero-640.jpg);background-size:150%;background-position:68% 34%}
.lf-photo::after{content:"";position:absolute;inset:0;
  background:linear-gradient(200deg,rgba(0,214,196,.12),rgba(5,11,31,.5))}
.lf-chip{
  position:absolute;display:flex;align-items:center;gap:9px;z-index:2;
  background:rgba(8,18,42,.76);border:1px solid var(--line-2);
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  border-radius:var(--r-pill);padding:9px 16px;
}
.lf-chip .ico{color:var(--turq)}
.lf-chip b{font-size:12px;font-weight:600;color:var(--text)}
.lf-chip--a{left:14px;top:14px}
.lf-chip--b{right:14px;bottom:14px}
.lifestyle-copy .tick-list{margin-top:24px}

@media (min-width:768px){
  .lf-photo{background-image:url(images/wecare-hero-960.jpg);background-size:150%}
  .lifestyle-figure{aspect-ratio:16/11}
}
@media (min-width:1024px){
  .lifestyle-grid{grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:64px;align-items:center}
  .lifestyle-figure{aspect-ratio:5/4}
  .lf-photo{background-size:170%;background-position:70% 36%}
  .lf-chip--a{left:22px;top:22px}
  .lf-chip--b{right:22px;bottom:22px}
  .lf-chip b{font-size:13.5px}
  .tick-list li{font-size:16.5px}
}

/* =====================================================================
   07. CONDITIONS + EVERYDAY HEALTH CONCERNS
   ===================================================================== */
.conditions{background:var(--bg-alt)}
.concern-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:30px}
.concern-grid li{
  display:flex;align-items:center;gap:11px;
  background:var(--glass);border:1px solid var(--line);border-radius:var(--r-pill);
  padding:10px 14px 10px 10px;font-size:12.5px;font-weight:600;line-height:1.3;color:var(--text);
}
.cg-ico{width:34px;height:34px;border-radius:50%;flex:none;display:grid;place-items:center;
  background:rgba(0,214,196,.12);border:1px solid rgba(0,214,196,.24)}
.cg-ico .ico{width:18px;height:18px;stroke:var(--turq);stroke-width:1.6}
.cond-intro{text-align:center;font-size:14.5px;font-weight:500;color:var(--text-3);margin-bottom:20px}

.condition-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.condition-grid li{
  display:flex;align-items:flex-start;gap:9px;
  background:var(--glass);border:1px solid var(--line);border-radius:16px;
  padding:13px 12px;font-size:12.5px;font-weight:500;line-height:1.35;color:var(--text-2);
}
.condition-grid .ico{width:14px;height:14px;color:var(--turq);margin-top:2px}
.condition-grid.is-collapsed li:nth-child(n+9){display:none}
.conditions-toggle{margin:22px auto 0;display:flex}
.ct-less{display:none}
.conditions-toggle[aria-expanded="true"] .ct-more{display:none}
.conditions-toggle[aria-expanded="true"] .ct-less{display:inline}
.ct-chevron{transition:transform .25s ease}
.conditions-toggle[aria-expanded="true"] .ct-chevron{transform:rotate(180deg)}

@media (min-width:520px){
  .concern-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  .concern-grid li{font-size:13px}
  .condition-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .condition-grid li{font-size:13.5px;padding:14px 15px}
}
@media (min-width:768px) and (max-width:1023px){
  .condition-grid.is-collapsed li:nth-child(n+9){display:flex}
  .conditions-toggle{display:none}
}
@media (min-width:1024px){
  .concern-grid{gap:16px;margin-bottom:40px}
  .concern-grid li{font-size:14.5px;padding:12px 20px 12px 12px}
  .cg-ico{width:42px;height:42px}
  .cg-ico .ico{width:21px;height:21px}
  .cond-intro{font-size:16.5px;margin-bottom:26px}
  .condition-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
  .condition-grid li{font-size:14.5px;padding:16px 18px;border-radius:18px}
  .condition-grid.is-collapsed li:nth-child(n+9){display:flex}
  .conditions-toggle{display:none}
}

/* =====================================================================
   07b. WHEN YOU NEED MORE THAN A TELECONSULTATION
   ===================================================================== */
.not-suitable{background:transparent}
.ns-grid{display:grid;gap:14px}
.ns-card{
  position:relative;overflow:hidden;
  background:var(--glass);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:26px 22px;box-shadow:var(--sh-card);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
}
.ns-watermark{position:absolute;right:-16px;bottom:-16px;width:124px;height:124px;
  fill:none;stroke:rgba(255,255,255,.05);stroke-width:1.2;pointer-events:none}
.ns-icon{
  width:56px;height:56px;border-radius:var(--r-pill);margin-bottom:16px;
  display:grid;place-items:center;position:relative;z-index:1;
  background:rgba(0,214,196,.12);border:1px solid rgba(0,214,196,.28);color:var(--turq);
}
.ns-card h3{font-size:18px;margin-bottom:10px;position:relative;z-index:1}
.ns-card p{font-size:14.5px;line-height:1.55;color:var(--text-3);position:relative;z-index:1}

/* Urgency: one restrained accent, never a red section */
.ns-card--urgent{border-color:var(--warn-line)}
.ns-card--urgent .ns-icon{background:var(--warn-bg);border-color:var(--warn-line);color:var(--warn)}
.ns-card--urgent .ns-watermark{stroke:rgba(255,150,80,.07)}

@media (min-width:768px){.ns-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}}
@media (min-width:1024px){
  .ns-grid{gap:26px}
  .ns-card{padding:38px 34px}
  .ns-card h3{font-size:21px}
  .ns-card p{font-size:16px}
  .ns-icon{width:64px;height:64px;margin-bottom:20px}
}

/* =====================================================================
   08. ELIGIBILITY
   ===================================================================== */
.eligibility{background:var(--bg-alt)}
.elig-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.elig-card{
  background:var(--glass);border:1px solid var(--line);border-radius:var(--r-card);
  padding:26px 14px;text-align:center;box-shadow:var(--sh-card);
  transition:transform .25s ease,border-color .25s ease;
}
.elig-card:hover{transform:translateY(-4px);border-color:var(--line-2)}
.elig-icon{width:62px;height:62px;margin:0 auto 14px;border-radius:var(--r-pill);
  display:grid;place-items:center;
  background:rgba(0,214,196,.1);border:1px solid rgba(0,214,196,.26)}
.elig-icon .ico{stroke:var(--turq);stroke-width:1.5}
.elig-card h3{font-size:15px;letter-spacing:-.015em}

@media (min-width:768px){
  .elig-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .elig-card{padding:32px 16px}
  .elig-card h3{font-size:16.5px}
}
@media (min-width:1024px){
  .elig-grid{gap:20px}
  .elig-card{padding:40px 22px;border-radius:var(--r-lg)}
  .elig-icon{width:74px;height:74px;margin-bottom:18px}
  .elig-icon .ico{width:34px;height:34px}
  .elig-card h3{font-size:18px}
}

/* =====================================================================
   09. PRICING
   ===================================================================== */
.pricing{background:transparent}
.price-today{
  display:grid;gap:14px;align-items:center;text-align:center;
  background:var(--glass);border:1px solid var(--line-2);border-radius:var(--r-lg);
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  padding:28px 20px;
}
.pt-label{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-3)}
.pt-amount{font-family:"Red Hat Display",sans-serif;font-size:52px;font-weight:800;
  letter-spacing:-.045em;color:var(--text);line-height:1;margin:6px 0 8px}
.pt-amount--after{font-size:36px}
.pt-amount .per{font-family:"Outfit",sans-serif;font-size:14px;font-weight:500;letter-spacing:0;color:var(--text-3);margin-left:7px}
.pt-note{font-size:13.5px;color:var(--text-3)}
.pt-arrow{display:grid;place-items:center;color:var(--turq)}
.pt-arrow .ico{width:28px;height:28px;stroke-width:1.8}
.pt-block--now .pt-amount{background-image:var(--grad-accent);-webkit-background-clip:text;background-clip:text;color:transparent}

.pricing-lede{margin:34px 0 22px;text-align:center;font-size:16.5px;font-weight:500;color:var(--text-2)}

.plan-grid{display:grid;gap:22px}
.plan-card{
  position:relative;background:var(--glass);border:1px solid var(--line);
  border-radius:var(--r-lg);padding:28px 24px;box-shadow:var(--sh-card);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
  transition:transform .25s ease,border-color .25s ease;
}
.plan-card:hover{transform:translateY(-4px);border-color:var(--line-2)}
.plan-card--featured{
  border-color:rgba(0,214,196,.5);
  background:linear-gradient(170deg,rgba(0,214,196,.13) 0%,rgba(255,255,255,.05) 60%);
  box-shadow:0 0 0 1px rgba(0,214,196,.2),0 28px 60px -30px rgba(0,214,196,.5);
}
.plan-flag{
  position:absolute;top:-13px;left:24px;
  background-image:var(--grad-pill);color:var(--on-accent);
  font-size:10.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  padding:6px 14px;border-radius:var(--r-pill);box-shadow:var(--glow-sm);
}
.plan-name{font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-3);margin-bottom:12px}
.plan-price{font-family:"Red Hat Display",sans-serif;font-size:44px;font-weight:800;
  letter-spacing:-.045em;color:var(--text);line-height:1}
.plan-price .per{font-family:"Outfit",sans-serif;font-size:14px;font-weight:500;letter-spacing:0;color:var(--text-3);margin-left:6px}
.plan-was{margin-top:10px;font-size:13.5px;color:var(--text-3)}
.plan-was s{color:rgba(255,255,255,.35)}
.plan-points{margin-top:18px;display:grid;gap:9px}
.plan-points li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;color:var(--text-2)}
.plan-points .ico{color:var(--turq);margin-top:3px}
.plan-footnote{margin-top:22px;text-align:center;font-size:13.5px;color:var(--text-3)}

/* 10. PAYMENT DISCLOSURE */
.disclosure{
  display:flex;gap:16px;margin-top:34px;
  background:rgba(0,214,196,.09);border:1px solid rgba(0,214,196,.32);
  border-radius:var(--r-lg);padding:24px 20px;
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
}
.disclosure-icon{width:50px;height:50px;border-radius:var(--r-pill);flex:none;display:grid;place-items:center;
  background:rgba(0,214,196,.16);border:1px solid rgba(0,214,196,.3);color:var(--turq)}
.disclosure h3{font-size:20px;margin-bottom:11px;letter-spacing:-.025em}
.disclosure p{font-size:14.5px;line-height:1.55;color:var(--text-2)}
.disclosure p+p{margin-top:12px}
.disclosure-strong{font-weight:600;color:var(--text)}
.trial-end{font-weight:700;color:var(--turq);text-decoration:underline;
  text-decoration-color:rgba(0,214,196,.5);text-underline-offset:4px;text-decoration-thickness:2px}

.pricing-cta{margin-top:34px;text-align:center}
.cta-sub{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:14px;
  font-size:13.5px;font-weight:500;color:var(--text-3)}
.cta-sub .ico{color:var(--turq)}

@media (min-width:600px){
  .price-today{grid-template-columns:1fr auto 1fr;gap:22px;padding:34px 28px}
  .pt-arrow .ico{transform:rotate(-90deg)}
}
@media (min-width:768px){
  .plan-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .disclosure{padding:28px;gap:20px}
  .disclosure h3{font-size:23px}
  .disclosure p{font-size:15.5px}
  .pricing-cta .btn{width:auto;min-width:340px}
}
@media (min-width:1024px){
  .price-today{padding:48px 52px}
  .pt-amount{font-size:72px}
  .pt-amount--after{font-size:50px}
  .pt-label{font-size:12px}
  .pt-note{font-size:15px}
  .plan-grid{gap:26px}
  .plan-card{padding:38px 34px}
  .plan-price{font-size:54px}
  .plan-points li{font-size:15.5px}
  .pricing-lede{font-size:19px;margin:44px 0 30px}
  .disclosure{padding:36px 40px;margin-top:44px}
  .disclosure h3{font-size:28px}
  .disclosure p{font-size:17px}
  .disclosure-icon{width:58px;height:58px}
}

/* =====================================================================
   11. WEKONGSI COST-SHARING (secondary)
   ===================================================================== */
.cost-sharing{background:var(--bg-alt)}
.cs-card{display:grid;background:var(--glass);border:1px solid var(--line);
  border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--sh-card)}
.cs-figure{position:relative;aspect-ratio:16/9;
  background:linear-gradient(150deg,rgba(0,214,196,.14) 0%,rgba(5,11,31,.6) 100%)}
.cs-fallback{overflow:hidden}
.cs-mark{width:82px;height:82px;stroke:var(--turq);stroke-width:1.3;position:relative;z-index:1}
.cs-orb{position:absolute;border-radius:50%}
.cs-orb--1{width:200px;height:200px;left:-46px;top:-56px;
  background:radial-gradient(circle,rgba(0,214,196,.4),rgba(0,214,196,0) 70%)}
.cs-orb--2{width:240px;height:240px;right:-64px;bottom:-86px;
  background:radial-gradient(circle,rgba(0,143,137,.3),rgba(0,143,137,0) 70%)}
.cs-fallback::after{content:"";position:absolute;width:150px;height:150px;border-radius:50%;
  border:1.5px dashed rgba(0,214,196,.28)}
.cs-body{padding:26px 22px 30px}
.cs-body h2{font-size:clamp(23px,6vw,30px)}
.cs-lede{margin-top:10px;font-size:16px;font-weight:600;color:var(--turq)}
.cs-body>p:last-of-type{margin-top:12px;font-size:14.5px;color:var(--text-3)}
.cs-body .btn{margin-top:22px}

@media (min-width:768px){
  .cs-card{grid-template-columns:minmax(0,.85fr) minmax(0,1fr);align-items:center}
  .cs-figure{aspect-ratio:auto;height:100%;min-height:280px}
  .cs-body{padding:36px 38px}
  .cs-body .btn{min-width:210px}
}
@media (min-width:1024px){
  .cs-body{padding:52px 56px}
  .cs-figure{min-height:340px}
  .cs-mark{width:96px;height:96px}
  .cs-fallback::after{width:190px;height:190px}
}

/* =====================================================================
   12. FAQ
   ===================================================================== */
.faq{background:transparent}
.faq-list{display:grid;gap:12px}
.faq-item{
  background:var(--glass);border:1px solid var(--line);border-radius:var(--r-card);
  transition:border-color .25s ease,background-color .25s ease;
}
.faq-item.is-open{border-color:rgba(0,214,196,.4);background:var(--glass-2)}
.faq-item h3{font-size:15.5px;font-weight:600}
.faq-q{
  width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;
  text-align:left;padding:19px 20px;min-height:60px;cursor:pointer;
  font-family:"Outfit",sans-serif;font-size:15.5px;font-weight:600;color:var(--text);line-height:1.35;
  border-radius:var(--r-card);
}
.faq-q:hover{color:var(--turq)}
.faq-chevron{color:var(--turq);transition:transform .25s ease;flex:none}
.faq-q[aria-expanded="true"] .faq-chevron{transform:rotate(180deg)}
.faq-a{display:grid;grid-template-rows:1fr;transition:grid-template-rows .3s cubic-bezier(.22,.7,.3,1)}
.faq-a[data-collapsed]{grid-template-rows:0fr}
.faq-a-inner{overflow:hidden}
.faq-a p{padding:0 20px 20px;font-size:14.5px;line-height:1.6;color:var(--text-3)}

@media (min-width:768px){
  .faq-q,.faq-item h3{font-size:17px}
  .faq-q{padding:22px 26px;min-height:66px}
  .faq-a p{padding:0 26px 24px;font-size:15.5px}
}

/* =====================================================================
   13. FINAL CTA
   ===================================================================== */
.final-cta{position:relative;overflow:hidden;text-align:center;padding-block:76px;
  background:linear-gradient(170deg,var(--bg-alt) 0%,var(--bg-deep) 100%)}
.final-cta::before{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(620px 420px at 50% 0%,rgba(0,214,196,.25),transparent 65%);
}
.fc-deco{position:absolute;inset:0;opacity:.22;pointer-events:none}
.fc-deco svg{width:100%;height:100%}
.fc-inner{position:relative;z-index:1}
.final-cta h2{color:var(--text);max-width:17ch;margin-inline:auto}
.fc-lede{margin-top:16px;font-size:17px;font-weight:500;color:var(--text-2)}
.final-cta .btn{margin-top:30px}
.fc-sub{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:16px;
  font-size:13.5px;font-weight:500;color:var(--text-3)}
.fc-sub .ico{color:var(--turq)}

@media (min-width:768px){
  .final-cta{padding-block:104px}
  .final-cta .btn{width:auto;min-width:340px}
  .fc-lede{font-size:19px}
}
@media (min-width:1024px){.final-cta{padding-block:140px}}

/* =====================================================================
   14. FOOTER
   ===================================================================== */
.site-footer{background:var(--bg-deep);border-top:1px solid var(--line);
  color:var(--text-3);padding-block:52px 34px}
.footer-inner{display:grid;gap:30px}
.footer-logo{width:170px;height:auto;filter:brightness(0) invert(1);opacity:.92}
.footer-tagline{margin-top:16px;font-size:14.5px;font-weight:500;color:var(--text-2)}
.footer-nav{display:grid;gap:14px}
.footer-nav a{font-size:14.5px;color:var(--text-2);transition:color .2s ease}
.footer-nav a:hover{color:var(--turq)}
.footer-legal{margin-top:34px;padding-top:26px;border-top:1px solid var(--line)}
.footer-legal p{font-size:12.5px;line-height:1.7;color:var(--text-3)}
.footer-copy{margin-top:14px;opacity:.75}

@media (min-width:768px){
  .footer-inner{grid-template-columns:1fr auto;align-items:start;gap:44px}
  .footer-nav{grid-auto-flow:column;gap:32px;align-items:center}
}
@media (min-width:1024px){.site-footer{padding-block:72px 40px}.footer-logo{width:190px}}

/* =====================================================================
   15. MOBILE STICKY CTA
   ===================================================================== */
.sticky-cta{
  position:fixed;left:0;right:0;bottom:0;z-index:90;
  background:rgba(5,11,31,.88);
  -webkit-backdrop-filter:saturate(180%) blur(18px);backdrop-filter:saturate(180%) blur(18px);
  border-top:1px solid var(--line);
  padding:12px var(--pad-x);padding-bottom:calc(12px + env(safe-area-inset-bottom));
  transform:translateY(130%);transition:transform .32s cubic-bezier(.22,.7,.3,1);
}
.sticky-cta.is-visible{transform:translateY(0)}
.sticky-inner{display:flex;align-items:center;gap:14px;max-width:640px;margin-inline:auto}
.sticky-text{display:none;flex:none}
.sticky-text b{display:block;font-size:14px;font-weight:700;color:var(--text);line-height:1.2}
.sticky-text span{display:block;font-size:11.5px;color:var(--text-3)}
.sticky-cta .btn{flex:1;min-height:52px;font-size:15px}

@media (min-width:420px){.sticky-text{display:block}}
@media (max-width:1023px){body{padding-bottom:calc(80px + env(safe-area-inset-bottom))}}
@media (min-width:1024px){.sticky-cta{display:none}}

/* =====================================================================
   16. SCROLL REVEAL + MOTION
   ===================================================================== */
.js .reveal{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .75s cubic-bezier(.22,.7,.3,1)}
.js .reveal.is-visible{opacity:1;transform:none}
.js .benefit-grid .reveal:nth-child(2),.js .elig-grid .reveal:nth-child(2),
.js .plan-grid .reveal:nth-child(2),.js .why-grid .reveal:nth-child(2){transition-delay:.07s}
.js .benefit-grid .reveal:nth-child(3),.js .elig-grid .reveal:nth-child(3),
.js .plan-grid .reveal:nth-child(3),.js .why-grid .reveal:nth-child(3){transition-delay:.14s}
.js .benefit-grid .reveal:nth-child(4),.js .elig-grid .reveal:nth-child(4),
.js .why-grid .reveal:nth-child(4){transition-delay:.21s}
.js .steps .reveal:nth-child(2){transition-delay:.1s}
.js .steps .reveal:nth-child(3){transition-delay:.2s}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important}
  .js .reveal{opacity:1;transform:none}
  .step-line{transform:none !important}
  .float-card{animation:none}
}

@media print{
  .sticky-cta,.site-header,.hero-deco,.fc-deco{display:none !important}
  body{padding-bottom:0;background:#fff;color:#000}
  body::before{display:none}
}
